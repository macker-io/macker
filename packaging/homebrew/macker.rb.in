# Homebrew formula for the CLI prefix produced by `make dist`.
#
# Local:
#   VERSION=0.1.0 make dist
#   brew install --formula dist/homebrew/Formula/macker.rb
#
# Tap (after a GitHub release of the same tarball):
#   copy dist/homebrew/macker.rb into the tap (URL/sha256/version already filled).
#
# Do not replace the exec wrappers with bin symlinks: SwiftPM resource
# bundles are resolved via Bundle.main, which follows the invoked path.
class Macker < Formula
  desc "macOS-native Linux containers"
  homepage "https://github.com/macker-io/macker"
  url "__URL__"
  version "__VERSION__"
  sha256 "__SHA256__"
  license "Apache-2.0"

  depends_on macos: :sequoia
  depends_on arch: :arm64

  def install
    libexec.install "libexec/macker"

    %w[macker mackerd].each do |name|
      (bin/name).write <<~SH
        #!/bin/bash
        exec "#{opt_libexec}/macker/#{name}" "$@"
      SH
      (bin/name).chmod 0755
    end

    pkgshare.install Dir["share/macker/*"]

    system "codesign", "--force", "--sign", "-",
           "--timestamp=none",
           "--entitlements", pkgshare/"mackerd.entitlements",
           libexec/"macker/mackerd"
  end

  service do
    run [opt_libexec/"macker/mackerd"]
    keep_alive true
    require_root false
    log_path var/"log/mackerd.log"
    error_log_path var/"log/mackerd.log"
  end

  def caveats
    <<~EOS
      Start the daemon:
        brew services start macker

      The CLI talks to:
        ~/Library/Application Support/io.macker.daemon/macker.sock

      The GUI cask (macker-app) is separate and can coexist; only one
      mackerd should own the store.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/macker --version")
  end
end
